// Icon, manifest and version block of SeaShell.exe. version.h is written by
// CMakeLists.txt from package.json's version.
#include <windows.h>
#include <winver.h>
#include "version.h"

#define IDI_APP 101
IDI_APP ICON "..\\..\\build\\icon.ico"
1 RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION SEASHELL_VERSION_CSV
 PRODUCTVERSION SEASHELL_VERSION_CSV
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "ProductName", "SeaShell"
      VALUE "FileDescription", "SeaShell"
      VALUE "FileVersion", SEASHELL_VERSION_STR
      VALUE "ProductVersion", SEASHELL_VERSION_STR
      VALUE "OriginalFilename", "SeaShell.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
